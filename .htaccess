# Matthew Carlson Consulting: Apache config (GoDaddy)

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS (uncomment after SSL is confirmed working)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Retired pages
RewriteRule ^automations\.html$ /services.html#patterns [R=301,NE,L]
Redirect 301 /bot.html /ai-bot.html
Redirect 301 /articles.html /projects.html
Redirect 301 /article.html /projects.html

Options -Indexes

# Never serve version-control or hidden folders (e.g. a .git folder left on the server)
RedirectMatch 404 /\.(git|svn|hg)(/|$)

# Keep repo-only files private if they are ever uploaded by mistake
<FilesMatch "\.(md|py|sh|bat|zip|jsonl|log|example\.php)$">
    Require all denied
</FilesMatch>

AddType text/html .html
AddType text/css .css
AddType application/javascript .js
AddType image/svg+xml .svg
AddType "text/plain; charset=UTF-8" .txt
AddCharset UTF-8 .html .css .js .xml

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Keep the chat and mail endpoints out of search results
    <FilesMatch "\.(php)$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
    # Tell crawlers where the LLM-readable summary lives
    <FilesMatch "\.html$">
        Header add Link "<https://matthewcarlsonconsulting.com/llms.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"LLM summary\""
    </FilesMatch>
</IfModule>

# Canonical host: send www to the bare domain (uncomment once HTTPS is forced)
# RewriteCond %{HTTP_HOST} ^www\.matthewcarlsonconsulting\.com$ [NC]
# RewriteRule ^(.*)$ https://matthewcarlsonconsulting.com/$1 [R=301,L]
